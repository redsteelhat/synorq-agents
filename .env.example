# --- Required ---
DATABASE_URL=postgres://user:password@host:5432/agents
# Dashboard sign-in. Use a long random password (at least 16 characters).
# Changing it signs out every session.
ADMIN_USER=admin
ADMIN_PASSWORD=
# Public address of the dashboard, used for links in Telegram messages.
PUBLIC_URL=https://agents.synorq.com

# --- Claude ---
# Long-lived token from `claude setup-token` (Pro/Max plan). Internal agents only:
# anything that serves clients or end users needs a Console API key instead.
CLAUDE_CODE_OAUTH_TOKEN=
AGENT_MODEL=sonnet

# --- Notifications and monitoring ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SENTRY_DSN=

# --- Ops agent integrations (read-only credentials) ---
COOLIFY_URL=https://panel.synorq.com
COOLIFY_API_TOKEN=
SENTRY_API_URL=https://de.sentry.io
SENTRY_ORG=synorq
SENTRY_API_TOKEN=
UPTIMEROBOT_API_KEY=
UMAMI_URL=https://analytics.synorq.com
UMAMI_USERNAME=
UMAMI_PASSWORD=

# --- Lead agent ---
# Google Cloud key with "Places API (New)" enabled. Restrict it to that API.
GOOGLE_PLACES_API_KEY=
# Optional: PageSpeed Insights API key (works without one at a lower rate).
GOOGLE_PAGESPEED_API_KEY=

# --- Optional ---
TZ_NAME=Europe/Istanbul
RUN_RETENTION_DAYS=90
